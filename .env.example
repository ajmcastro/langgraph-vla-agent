# Copy this file to .env and fill in values. Never commit .env.
# All variables are optional unless a specific milestone requires them.
# The package degrades gracefully when optional vars are absent.

# ---------------------------------------------------------------------------
# LLM provider — required for LLMTaskPlanner (Milestone 5+)
# Choose one. The agent layer is provider-agnostic; configure the matching
# langchain-<provider> extra and set the corresponding key here.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Hugging Face Hub — required for dataset streaming and model downloads
# (Milestone 2+ for datasets, Milestone 3+ for SmolVLA checkpoints)
# Create a token at https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------------
# HUGGINGFACE_TOKEN=

# ---------------------------------------------------------------------------
# Experiment tracking — optional (Milestone 4+)
# ---------------------------------------------------------------------------
# WANDB_API_KEY=
# WANDB_PROJECT=langgraph-vla-agent
# MLFLOW_TRACKING_URI=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT=json   # set to 'json' for structured JSON output in production
